# ========================================================
# SHIPVERA — PRODUCTION ENVIRONMENT CONFIGURATION
# Fill these keys to switch from sandbox simulation to real live calling
# ========================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=https://app.shipvera.com

# 1.1 Cloud Database (Supabase PostgreSQL - Recommended for Render)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 1.2 Google Maps Platform API
GOOGLE_MAPS_API_KEY=AIzaSy...

# 2. Voice AI Orchestrator (PRD: Bolna.dev / Vapi / Retell)
# Bolna is India-native, built for Hinglish accents and Exotel/Plivo SIP trunks
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
SARVAM_API_KEY=your_sarvam_bulbul_tts_key_here

# 3. Indian Telephony (Exotel / Plivo 140 Transactional Series)
EXOTEL_ACCOUNT_SID=your_exotel_sid_here
EXOTEL_API_KEY=your_exotel_key_here
EXOTEL_API_TOKEN=your_exotel_token_here
EXOTEL_CALLER_ID=0804xxxxxxx # Truecaller Verified: "Order Dispatch Desk"

# 4. Shopify Store Integration (Admin REST / GraphQL API)
SHOPIFY_SHOP_DOMAIN=your-brand.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_shopify_hmac_secret_here

# 5. Shiprocket Courier Sync API
SHIPROCKET_EMAIL=operations@yourbrand.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# 6. Razorpay (₹19 UPI Micro-Trust Lock & Wallet Recharges)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# 7. WhatsApp Business API (WABA) for ₹19 Trust Lock Fallback
WHATSAPP_API_TOKEN=your_meta_cloud_waba_token_here
WHATSAPP_PHONE_NUMBER_ID=your_waba_phone_id_here
WHATSAPP_TEMPLATE_NAME=order_dispatch_trust_lock_v1
