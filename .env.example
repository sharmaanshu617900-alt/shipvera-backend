# Shipvera / RTO Shield - environment variables
# Copy this file to .env and fill in real values from your own accounts.
# NEVER commit a real .env file, and NEVER put a real secret in this file.
# Empty values below are intentional placeholders only.

# Server
PORT=3000
NODE_ENV=
BASE_URL=

# Database (Supabase PostgreSQL)
# The current db.js still uses a local JSON file. Supabase is used by
# services/supabaseClient.js for cloud lookups; a full migration of
# db.js to Supabase tables is still required (see REALITY_CHECKLIST.md).
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps geocoding (optional but required for real deliverability scores)
GOOGLE_MAPS_API_KEY=

# Voice AI - Bolna (required for live calls)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_PHONE_NUMBER=

# LLM extraction (required for PRD LLM address extraction; without it the
# rule-based extractor returns low-confidence / needs-review results)
LLM_API_KEY=
LLM_MODEL=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Razorpay (required for real 19 UPI Trust Lock links and wallet top-ups)
# Razorpay account activation/approval is required before live mode works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business (Meta Cloud API, required for Trust Lock messages)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Email digest (optional)
RESEND_API_KEY=

# Local testing only. Default is live mode. Set to exactly "true" only
# for local testing when you explicitly want a simulated call result,
# which will never invent a transcript, recording, or buyer outcome.
SHIPVERA_ALLOW_SIMULATED_CALLS=
