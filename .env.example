# ====================================================================
# TrustOrder by Shipvera - Environment Variables
# ====================================================================
# Copy this template to .env and provide your production credentials.
# NEVER commit your real .env file and NEVER put real secrets in this template.
# All values below are intentional empty placeholders.
# If any live credential is not configured, TrustOrder strictly fails closed
# with success:false and the exact missing environment variable name.
# ====================================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=
BASE_URL=

# 2. Database - Supabase PostgreSQL Cloud
# Run migrations/001_initial_schema.sql in the Supabase SQL Editor first.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Google Maps Platform (Address Geocoding & Deliverability Scoring)
# Needs Geocoding API enabled on Google Cloud. Without this, coords & score are null.
GOOGLE_MAPS_API_KEY=

# 4. Voice AI - Bolna (25s Landmark Interrogator Calls)
# Requires a new/rotated API key, Agent ID, and verified caller number.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_PHONE_NUMBER=

# 5. LLM Extraction (Structured Rooftop Address Parsing)
# Rule-based fallback caps confidence at 85 if LLM key is absent.
LLM_API_KEY=
LLM_MODEL=

# 6. Shopify Admin & Webhook Integration
# HMAC verification strictly verified on every webhook.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# 7. Shiprocket Logistics API
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# 8. Razorpay Payment Gateway (ONLY supported payment provider)
# Used for: Wallet recharges, monthly/annual subscriptions, ₹19 Trust Lock, and RTO Prepaid Recovery.
# Test keys (rzp_test_*) and Live keys (rzp_live_*) must be strictly segregated.
# Live mode requires Razorpay KYC & merchant activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 9. WhatsApp Business - Meta Cloud API
# Used for Trust Lock links & RTO Recovery fallback messaging within the same credit.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# 10. Email Notifications (Resend API)
RESEND_API_KEY=

# 11. Testing & Simulation Overrides
# Default is false (strictly live calls). Set to "true" ONLY for offline mock tests.
# Simulated calls will never invent fake transcripts, recordings, or buyer intents.
SHIPVERA_ALLOW_SIMULATED_CALLS=
